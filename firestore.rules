rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // ── 프로필 · 전적 (users/{uid}) ──
    // 누구나(로그인한 사람) 볼 수 있고, 본인 것만 고칠 수 있어요.
    // 단, 가넷·전적·최고 기록은 서버(/api/record, /api/best)만 바꿀 수 있어요 (조작 방지).
    function valueKeys() { return ['garnets', 'stats', 'ghist', 'lastMatch', 'recentMatches', 'best', 'bestAt']; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && !request.resource.data.keys().hasAny(valueKeys());
      allow update: if signedIn() && me() == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(valueKeys());
      allow delete: if false;
    }

    // ── 게임 방 (rooms/{code}) ──
    // 방 코드를 아는 사람만 열 수 있어요 (방 목록 전체 조회는 막음).
    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if false;
      // 방 만들기: 내가 방장이고, 처음엔 나 혼자
      allow create: if signedIn()
        && request.resource.data.hostId == me()
        && request.resource.data.status == 'waiting'
        && request.resource.data.players.keys().hasOnly([me()])
        && request.resource.data.result == null;
      allow update: if signedIn() && (
        // 참가자: 게임 진행·나가기·내보내기는 되지만, 다른 사람을 새로 넣을 수는 없어요
        (me() in resource.data.players
          && request.resource.data.players.keys().hasOnly(resource.data.players.keys()))
        ||
        // 새로 들어오는 사람: 대기 중인 방에 '나'만 추가할 수 있어요
        (!(me() in resource.data.players)
          && resource.data.status == 'waiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([me()])
          && me() in request.resource.data.players
          && request.resource.data.players.size() <= 10)
      );
      // 방 삭제: 방장, 또는 마지막 남은 사람
      allow delete: if signedIn() && (resource.data.hostId == me()
        || (me() in resource.data.players && resource.data.players.size() == 1));
    }

    // ── 친구 DM (dms/{a__b}) ──
    // 두 사람만 읽을 수 있고, 각자 자기 칸(a 또는 b)만 쓸 수 있어요.
    function slot(d) { return d.users[0] == me() ? 'a' : 'b'; }
    match /dms/{pair} {
      allow read: if signedIn() && me() in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && me() in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && pair == request.resource.data.users[0] + '__' + request.resource.data.users[1]
        && request.resource.data.keys().hasOnly(['users', slot(request.resource.data)])
        && request.resource.data[slot(request.resource.data)].size() <= 40;
      allow update: if signedIn()
        && me() in resource.data.users
        && request.resource.data.users == resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([slot(resource.data)])
        && request.resource.data[slot(resource.data)].size() <= 40;
      allow delete: if false;
    }
  }
}
